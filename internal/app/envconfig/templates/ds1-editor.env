# Dark Magic DS1 Editor environment
# This standalone authoring tool never starts a game session. Exported values
# override this file; command-line flags override both.

# Directory containing legally supplied Diablo II MPQ archives or unpacked data.
MPQ_DIRECTORY=
# Optional owner-local digest cache path; leave empty for the platform cache.
DARK_MAGIC_ASSET_SET_CACHE=
DARK_MAGIC_ASSET_SET_REHASH=0

# The only directory the editor may write to. Leave empty to use the platform
# Dark Magic configuration directory.
DARK_MAGIC_DS1_EDITOR_OUTPUT=
DARK_MAGIC_DS1_EDITOR_WINDOW_SIZE=1280x760
DARK_MAGIC_DS1_EDITOR_FULLSCREEN=false
DARK_MAGIC_MODS=none
DARK_MAGIC_OUTPUT_PALETTE=
