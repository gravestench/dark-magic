# Dark Magic standalone/dedicated game-server environment
# Realm-supervised worker flags remain allocator-owned and are not configured here.

# Directory containing legally supplied Diablo II MPQ archives.
MPQ_DIRECTORY=
# Optional owner-local digest cache path; leave empty for the platform cache.
DARK_MAGIC_ASSET_SET_CACHE=
DARK_MAGIC_ASSET_SET_REHASH=0

DARK_MAGIC_SERVER_LOG_LEVEL=info
DARK_MAGIC_MODS=
