# Dark Magic Realm environment
# This local profile exercises PostgreSQL-backed production repository behavior.
# Existing exported variables override this file; command-line flags override both.

# Directory containing legally supplied Diablo II MPQ archives.
MPQ_DIRECTORY=
# Optional owner-local digest cache path; leave empty for the platform cache.
DARK_MAGIC_ASSET_SET_CACHE=
DARK_MAGIC_ASSET_SET_REHASH=0

DARK_MAGIC_REALM_LOG_LEVEL=debug
DARK_MAGIC_REALM_LISTEN=127.0.0.1:6112
DARK_MAGIC_REALM_ACCOUNT_URL=https://127.0.0.1:6112
DARK_MAGIC_REALM_DATA=
DARK_MAGIC_REALM_RUNTIME_DIR=

# The lifecycle scripts manage an isolated local PostgreSQL cluster by default.
DARK_MAGIC_REALM_MANAGE_POSTGRES=1
DARK_MAGIC_REALM_POSTGRES_HOST=127.0.0.1
DARK_MAGIC_REALM_POSTGRES_PORT=55432
DARK_MAGIC_REALM_POSTGRES_DATABASE=realm
DARK_MAGIC_REALM_POSTGRES_USER=realm
DARK_MAGIC_REALM_POSTGRES_PASSWORD=dark-magic-local-development-only
DARK_MAGIC_REALM_POSTGRES_URL=postgres://realm:dark-magic-local-development-only@127.0.0.1:55432/realm?sslmode=disable

# Local production-semantics convenience: use log to consume links manually.
DARK_MAGIC_REALM_ACCOUNT_MAIL_MODE=auto-verify
DARK_MAGIC_REALM_SMTP_ADDRESS=
DARK_MAGIC_REALM_SMTP_FROM=realm@dark-magic.test
DARK_MAGIC_REALM_SMTP_USERNAME=
DARK_MAGIC_REALM_SMTP_PASSWORD=

DARK_MAGIC_REALM_WORKER=
DARK_MAGIC_REALM_WORKER_CONTROL_LISTEN=127.0.0.1:0
DARK_MAGIC_REALM_WORKER_GAME_LISTEN=0.0.0.0:0
DARK_MAGIC_REALM_GAME_HOST=127.0.0.1
DARK_MAGIC_REALM_DISABLE_WORKERS=0
DARK_MAGIC_REALM_CHECKPOINT_INTERVAL=15s
# Channel rosters are live presence, not account history. A client that stops
# renewing its channel membership disappears after this interval.
DARK_MAGIC_REALM_PRESENCE_TIMEOUT=30s

# Optional owner-only operator capability. Lifecycle scripts default this to a
# generated token beneath their private runtime directory.
DARK_MAGIC_REALM_OPERATOR_TOKEN_FILE=
DARK_MAGIC_REALM_OPERATOR_LISTEN=127.0.0.1:6113
