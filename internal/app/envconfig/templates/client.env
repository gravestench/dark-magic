# Dark Magic client environment
# Existing exported variables override this file; command-line flags override both.

# Directory containing legally supplied Diablo II MPQ archives.
MPQ_DIRECTORY=
# Optional owner-local digest cache path; leave empty for the platform cache.
DARK_MAGIC_ASSET_SET_CACHE=
DARK_MAGIC_ASSET_SET_REHASH=0

DARK_MAGIC_LOG_LEVEL=info
DARK_MAGIC_FULLSCREEN=false
DARK_MAGIC_VIEWPORT_FIT=contain
DARK_MAGIC_MODS=
DARK_MAGIC_OUTPUT_PALETTE=
DARK_MAGIC_PRESENTATION_PROFILE=

# Empty paths use the platform dark-magic configuration directory.
DARK_MAGIC_PLAYER_PROFILE=
DARK_MAGIC_PREFERENCES=
DARK_MAGIC_SHELL_CONFIG=

# Optional local diagnostics listener, for example 127.0.0.1:6060.
DARK_MAGIC_DEBUG_ADDR=
